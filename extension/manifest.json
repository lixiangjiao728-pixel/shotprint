{
  "manifest_version": 3,
  "name": "镜谱 Shotprint 取证桥",
  "version": "0.7.1",
  "version_name": "0.7.1",
  "description": "用户主动点击后识别三平台作品、采集匿名评论并读取可访问视频；受限时保留结果并提供录制或上传入口。",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*",
    "https://*.iesdouyin.com/*",
    "https://*.bilibili.com/*",
    "https://b23.tv/*",
    "https://www.xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://xhslink.com/*",
    "https://www.xhslink.com/*",
    "https://shotprint.xyz/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://shotprint.xyz/*"],
    "js": ["site-bridge.js"],
    "run_at": "document_idle"
  }]
}
