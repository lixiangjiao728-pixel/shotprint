{
  "manifest_version": 3,
  "name": "镜谱 Shotprint 取证桥",
  "version": "0.6.9",
  "version_name": "0.6.9",
  "description": "用户主动点击后采集三平台匿名评论；页面适配器失败时可配对本机BrowserAct伴侣安全降级。",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyin.com/*",
    "https://*.bilibili.com/*",
    "https://b23.tv/*",
    "https://www.xiaohongshu.com/*",
    "https://xhslink.com/*",
    "https://shotprint.xyz/*",
    "https://shotprint-ai-film.lixiangjia27.chatgpt.site/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://shotprint.xyz/*", "https://shotprint-ai-film.lixiangjia27.chatgpt.site/*", "http://localhost/*"],
    "js": ["site-bridge.js"],
    "run_at": "document_idle"
  }]
}
